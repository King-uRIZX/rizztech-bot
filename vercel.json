{
  "functions": {
    "api/webhook.py": {
      "runtime": "python3.12"
    },
    "api/health.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    }
  ]
}
